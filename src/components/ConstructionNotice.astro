---
import { t, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem;">
  <div class="construction-card">
    <div class="construction-icon">⚒</div>
    <div style="flex: 1; min-width: 0;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">
        <span class="construction-dot"></span>
        <span style="color: #c8a96e; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">{t(lang, 'construction.title')}</span>
      </div>
      <p style="color: #e8e0d0; font-size: 1rem; line-height: 1.7; margin: 0 0 0.5rem;">{t(lang, 'construction.body')}</p>
      <p style="color: #8a8fa8; font-size: 0.85rem; line-height: 1.6; margin: 0;">
        {t(lang, 'construction.contact')} <a href="mailto:contact@linuxiv.com" style="color: #c8a96e; text-decoration: none;">contact@linuxiv.com</a>
      </p>
    </div>
  </div>
</section>

<style>
  .construction-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border-radius: 12px;
    border: 1px solid rgba(200,169,110,0.3);
    background:
      linear-gradient(135deg, rgba(200,169,110,0.10), rgba(200,169,110,0.02) 60%),
      #1a1e2a;
    overflow: hidden;
  }
  .construction-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, #c8a96e, #e0c68a);
  }
  .construction-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: #c8a96e;
    background-color: rgba(200,169,110,0.12);
    border: 1px solid rgba(200,169,110,0.3);
  }
  .construction-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #c8a96e;
    animation: construction-pulse 2s infinite;
  }
  @keyframes construction-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @media (max-width: 520px) {
    .construction-card { flex-direction: column; gap: 1rem; padding: 1.25rem; }
  }
</style>
